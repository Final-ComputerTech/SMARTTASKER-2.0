# SMTP configuration (copy to .env and fill with your values)
# Example for Gmail using App Passwords
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=your.email@gmail.com
# SMTP_PASS=your_app_password_here
# EMAIL_FROM="SmartTasker <noreply@yourdomain.com>"
# NOTIFY_EMAIL=your.email@example.com

# Optional misc
# NOTIF_NEARING_HOURS=24
# NOTIF_DUE_SOON_MIN=5

# JWT secret (already present in your .env)
# JWT_SECRET=some_long_secret
